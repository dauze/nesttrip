rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Miroir de `authGuard` (src/app/core/guards/auth.guard.ts) : un compte dont l'email
    // n'est pas vérifié est traité comme non connecté côté client, l'app ne le laisse même
    // pas atteindre /trips — sans cette fonction, rien côté serveur n'empêchait un tel compte
    // de lire/écrire directement via le SDK en contournant le guard.
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /trips/{tripId} {
      // Accès restreint aux membres du trip (voir TripFirebase.members, Record<uid, TripMember>
      // rempli par NewTripComponent à la création puis exclusivement par les Cloud Functions
      // add-collaborator/remove-collaborator, Admin SDK — ces rules ne s'appliquent donc jamais
      // à ces écritures serveur). Avant ce correctif, `allow read, write: if request.auth != null`
      // laissait n'importe quel compte authentifié lire/modifier/supprimer n'importe quel trip.
      allow read: if isVerified() && resource.data.members[request.auth.uid] != null;

      allow create: if isVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid].role == 'owner';

      // `members`/`ownerId` ne sont jamais modifiés par le client après création (voir
      // CollaborationService, qui passe par les Cloud Functions ci-dessus) : on l'interdit
      // explicitement pour empêcher une auto-promotion/éviction via un appel SDK direct.
      allow update: if isVerified()
        && resource.data.members[request.auth.uid] != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'ownerId']);

      allow delete: if isVerified()
        && resource.data.members[request.auth.uid].role == 'owner';
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Exception ciblée (ROADMAP.md "### UI", préférence "carte repliée par
      // défaut", puis "### Devise" pour `defaultCurrency`, puis
      // src/specs/Parcours-new-user.md pour `onboarding`) : le client peut
      // modifier UNIQUEMENT ces champs précis de son propre document — tout
      // le reste (companions...) reste réservé au serveur (Cloud Functions,
      // Admin SDK), voir `allow write: if false` juste en dessous, qui
      // continue de s'appliquer à tout le reste.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mapCollapsedByDefault', 'defaultCurrency', 'onboarding']);
      // Création explicite à l'inscription (voir `AuthService.registerWithEmail`/
      // `loginWithGoogle`, `UserProfileRepository.createUserProfile`) : forme
      // minimale attendue, `companions` toujours vide à la création (la
      // dénormalisation bidirectionnelle réelle reste réservée au serveur, voir
      // `add-collaborator.handler.ts`/Admin SDK, qui contourne les rules).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.companions == {}
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'companions']);
      // Création paresseuse via une écriture onboarding-only (voir
      // `UserProfileDataSource.markOnboardingStepSeen`/`completeOnboardingIntro`)
      // — conservée pour les comptes créés avant l'ajout de la création
      // explicite ci-dessus (uid sans doc, `allow update` seul ne matche qu'un
      // doc déjà existant, ce qui faisait échouer silencieusement l'écriture
      // et rouvrir le tour de coach marks à chaque session pour ces comptes).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mapCollapsedByDefault', 'defaultCurrency', 'onboarding']);
      allow write: if false; // écrit uniquement côté serveur (Cloud Functions, Admin SDK)
    }

    // Job de génération de voyage assistée par IA (voir
    // src/specs/process-creation-trip-ia.md §4, TripGenerationDataSource) —
    // collection séparée de `trips/{tripId}`, un seul doc par trip. Créé côté
    // client (déclenche la Cloud Function), puis rempli par elle seule
    // (Admin SDK, hors rules) jusqu'à `ready_for_preview`/`failed`. Seul
    // "Régénérer tout" (§2.5) écrit à nouveau côté client, sur un sous-
    // ensemble précis de champs.
    match /tripGenerations/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.tripId == tripId
        && request.resource.data.status == 'generating';
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'preferences', 'candidates', 'preview', 'lodgingCandidates', 'lodgingPreview', 'transportSegments', 'updatedAt']);
      allow delete: if false;
    }

    // Cache global des trajets Google Routes API (voir get-trajet.handler.ts) —
    // lu directement par le client pour éviter même l'invocation de la Cloud
    // Function quand la paire de lieux est déjà connue, jamais écrit côté client.
    match /travelRoutes/{routeId} {
      allow read: if request.auth != null;
      allow write: if false; // écrit uniquement côté serveur (Cloud Functions, Admin SDK)
    }

    // Cache global des taux de change du jour (voir get-exchange-rates.handler.ts,
    // src/specs/devise.md) — lu directement par le client, jamais écrit côté client.
    match /exchangeRates/{dateKey} {
      allow read: if request.auth != null;
      allow write: if false; // écrit uniquement côté serveur (Cloud Functions, Admin SDK)
    }
  }
}
